# Telegram (required)
API_ID=""
API_HASH=""
BOT_TOKEN=""
OWNER_ID=""

# Database (required — comma-separated URIs, exactly 2: tracking, storage_1)
DATABASE=""

# Server (required)
PORT="8000"

# STRM / Emby Export Directory (optional)
STRM_EXPORT_DIR=

# Experimental Jellyfin Android compatibility API (runs inside this Heroku app)
JELLYFIN_COMPAT_ENABLED=false
JELLYFIN_USERNAME=
JELLYFIN_PASSWORD=
# Existing Telegram-Stremio API token used as the content permission/stream
# identity for the Jellyfin account. If empty, the STRM default token in the
# Web Panel is used. Never paste this token into the Jellyfin Android app.
JELLYFIN_SOURCE_TOKEN=
JELLYFIN_SERVER_ID=
JELLYFIN_SERVER_NAME=Telegram-Stremio
JELLYFIN_TOKEN_TTL_DAYS=30
JELLYFIN_PLAYBACK_TICKET_TTL_SECONDS=21600

# Keep false for the Jellyfin compatibility image; the legacy updater can overwrite it.
JELLYFIN_ALLOW_UPSTREAM_AUTO_UPDATE=false
